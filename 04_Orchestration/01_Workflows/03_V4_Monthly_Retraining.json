{
  "name": "v4_monthly_retraining",
  "description": "Monthly walk-forward retraining and artifact promotion for V4",
  "schedule": {
    "quartz_cron_expression": "0 30 20 1 * ?",
    "timezone_id": "America/New_York",
    "pause_status": "UNPAUSED"
  },
  "job_clusters": [
    {
      "job_cluster_key": "v4_job_cluster",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 1,
        "data_security_mode": "SINGLE_USER",
        "runtime_engine": "STANDARD",
        "aws_attributes": {
          "availability": "ON_DEMAND",
          "ebs_volume_type": "GENERAL_PURPOSE_SSD",
          "ebs_volume_count": 1,
          "ebs_volume_size": 100
        }
      }
    }
  ],
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "macro_incremental_update",
      "job_cluster_key": "v4_job_cluster",
      "libraries": [
        {"pypi": {"package": "finnhub-python==2.4.25"}},
        {"pypi": {"package": "fredapi==0.5.2"}}
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/pawan.jatale@mubama.group/V4_WF_RT_Regime_Strategy_Retraining_github/01_Processing/01_Ingestion/03_BT_Macro_Incremental_Update"
      }
    },
    {
      "task_key": "silver_incremental_refresh",
      "depends_on": [{"task_key": "macro_incremental_update"}],
      "job_cluster_key": "v4_job_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/pawan.jatale@mubama.group/V4_WF_RT_Regime_Strategy_Retraining_github/01_Processing/02_Features/02_BT_Incremental_Silver_Refresh"
      }
    },
    {
      "task_key": "monthly_walkforward_retrain",
      "depends_on": [{"task_key": "silver_incremental_refresh"}],
      "job_cluster_key": "v4_job_cluster",
      "libraries": [
        {"pypi": {"package": "xgboost==3.1.1"}}
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/pawan.jatale@mubama.group/V4_WF_RT_Regime_Strategy_Retraining_github/01_Processing/04_Retraining/01_Monthly_Walkforward_Retrain"
      }
    },
    {
      "task_key": "performance_exports",
      "depends_on": [{"task_key": "monthly_walkforward_retrain"}],
      "job_cluster_key": "v4_job_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/pawan.jatale@mubama.group/V4_WF_RT_Regime_Strategy_Retraining_github/02_Analysis/01_Performance/03_Performance_Exports"
      }
    }
  ]
}
