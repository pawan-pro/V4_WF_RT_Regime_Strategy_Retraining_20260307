{
  "name": "v4_saxo_live_hourly_chain",
  "description": "Live hourly Saxo execution chain for V4 after cutover",
  "schedule": {
    "quartz_cron_expression": "0 5 9-16 ? * MON-FRI",
    "timezone_id": "America/New_York",
    "pause_status": "PAUSED"
  },
  "job_clusters": [
    {
      "job_cluster_key": "v4_job_cluster",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 1,
        "data_security_mode": "SINGLE_USER",
        "runtime_engine": "STANDARD",
        "aws_attributes": {
          "availability": "ON_DEMAND",
          "ebs_volume_type": "GENERAL_PURPOSE_SSD",
          "ebs_volume_count": 1,
          "ebs_volume_size": 100
        }
      }
    }
  ],
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "rt_01_market",
      "job_cluster_key": "v4_job_cluster",
      "libraries": [
        {"pypi": {"package": "alpaca-py==0.43.2"}},
        {"pypi": {"package": "nest_asyncio==1.6.0"}}
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/pawan.jatale@mubama.group/V4_WF_RT_Regime_Strategy_Retraining_github/01_Processing/03_Realtime/01_RT_Live_Market_Ingestion"
      }
    },
    {
      "task_key": "rt_02_vix",
      "depends_on": [{"task_key": "rt_01_market"}],
      "job_cluster_key": "v4_job_cluster",
      "libraries": [
        {"pypi": {"package": "fredapi==0.5.2"}}
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/pawan.jatale@mubama.group/V4_WF_RT_Regime_Strategy_Retraining_github/01_Processing/03_Realtime/02_RT_Live_Rates_VIX_Ingestion"
      }
    },
    {
      "task_key": "rt_03_silver",
      "depends_on": [{"task_key": "rt_02_vix"}],
      "job_cluster_key": "v4_job_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/pawan.jatale@mubama.group/V4_WF_RT_Regime_Strategy_Retraining_github/01_Processing/03_Realtime/03_RT_Silver_RT_Enrichment"
      }
    },
    {
      "task_key": "rt_04_inference",
      "depends_on": [{"task_key": "rt_03_silver"}],
      "job_cluster_key": "v4_job_cluster",
      "libraries": [
        {"pypi": {"package": "xgboost==3.1.1"}}
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/pawan.jatale@mubama.group/V4_WF_RT_Regime_Strategy_Retraining_github/01_Processing/03_Realtime/04_RT_Model_Inference_Engine"
      }
    },
    {
      "task_key": "rt_08_saxo_execution",
      "depends_on": [{"task_key": "rt_04_inference"}],
      "job_cluster_key": "v4_job_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/pawan.jatale@mubama.group/V4_WF_RT_Regime_Strategy_Retraining_github/01_Processing/03_Realtime/08_RT_Saxo_Trade_Execution",
        "base_parameters": {
          "execution_mode": "live"
        }
      }
    },
    {
      "task_key": "rt_09_saxo_audit",
      "depends_on": [{"task_key": "rt_08_saxo_execution"}],
      "job_cluster_key": "v4_job_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/pawan.jatale@mubama.group/V4_WF_RT_Regime_Strategy_Retraining_github/01_Processing/03_Realtime/09_RT_Saxo_Signal_Audit_Log"
      }
    },
    {
      "task_key": "rt_10_saxo_dashboard",
      "depends_on": [{"task_key": "rt_09_saxo_audit"}],
      "job_cluster_key": "v4_job_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/pawan.jatale@mubama.group/V4_WF_RT_Regime_Strategy_Retraining_github/01_Processing/03_Realtime/10_RT_Saxo_Dashboard_Feed"
      }
    }
  ]
}
