{
  "name": "v4_macro_hourly_maintenance",
  "description": "Hourly macro update and bounded silver refresh for V4",
  "schedule": {
    "quartz_cron_expression": "0 15 8-17 ? * MON-FRI",
    "timezone_id": "America/New_York",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "macro_incremental_update",
      "libraries": [
        {"pypi": {"package": "finnhub-python==2.4.25"}},
        {"pypi": {"package": "fredapi==0.5.2"}}
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/pawan.jatale@mubama.group/V4_WF_RT_Regime_Strategy_Retraining_github/01_Processing/01_Ingestion/03_BT_Macro_Incremental_Update"
      }
    },
    {
      "task_key": "silver_incremental_refresh",
      "depends_on": [{"task_key": "macro_incremental_update"}],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/pawan.jatale@mubama.group/V4_WF_RT_Regime_Strategy_Retraining_github/01_Processing/02_Features/02_BT_Incremental_Silver_Refresh"
      }
    }
  ]
}
